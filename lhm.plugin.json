{
  "identifier": "ilyautov-wildberries-mcp-ru",
  "name": "Wildberries MCP (RU)",
  "version": "0.5.3",
  "description": "Wildberries seller API in your AI assistant: sales and stocks, product cards, prices and promotions, financial reports, reviews. 307 methods across all 17 Wildberries hosts live in a YAML catalog the server executes; the agent searches it in plain language and calls a method through three generic tools. Every method carries an access class: reads run immediately, writes and irreversible calls require confirmation. Keys stay on the user's machine.",
  "author": "Ilya Utov",
  "authorUrl": "https://github.com/ilyautov",
  "homepage": "https://github.com/ilyautov/wildberries-mcp-ru",
  "icon": "https://raw.githubusercontent.com/ilyautov/wildberries-mcp-ru/main/assets/logo.png",
  "tags": [
    "wildberries",
    "wildberries-api",
    "wb",
    "marketplace",
    "ecommerce",
    "seller-api",
    "russia"
  ],
  "localizations": [
    {
      "locale": "ru-RU",
      "name": "Wildberries MCP (RU)",
      "description": "API Wildberries для ИИ-ассистентов: продажи и остатки, карточки и характеристики, цены и акции, финансовые отчёты, отзывы. Семнадцать хостов WB разложены по каталогу. 307 методов живут в YAML-каталоге, который исполняет сервер: агент ищет метод словами и вызывает его тремя общими инструментами. У каждого метода класс доступа: чтение идёт сразу, запись и необратимое спрашивают подтверждение. Ключи остаются на машине пользователя."
    }
  ],
